---
// The pricing page footer, in the home page's style. Every link goes to a page
// or file that exists in this build (see links.ts).
import { contactHref, TEAMS_HREF, SECURITY_HREF, ROADMAP_HREF } from './links';

const COLS = [
	{
		title: 'Product',
		links: [
			{ href: 'https://github.com/ikenga-hq/ikenga/releases/latest', label: 'Download' },
			{ href: 'https://github.com/ikenga-hq/ikenga/releases', label: 'Changelog' },
			{ href: ROADMAP_HREF, label: 'Roadmap' },
			{ href: '/pricing/', label: 'Pricing' },
			{ href: TEAMS_HREF, label: 'Teams' },
			{ href: SECURITY_HREF, label: 'Security' },
		],
	},
	{
		title: 'Build',
		links: [
			{ href: '/docs/', label: 'Docs' },
			{ href: '/docs/build-a-pkg/', label: 'Builder docs' },
			{ href: '/packages/', label: 'Signed catalogue' },
			{ href: 'https://github.com/ikenga-hq', label: 'GitHub' },
		],
	},
	{
		title: 'Company',
		links: [
			{ href: '/open-source/', label: 'Open source' },
			{ href: '/blog/', label: 'Blog' },
			{ href: contactHref('team'), label: 'Contact' },
		],
	},
	{
		title: 'Community',
		links: [
			{ href: 'https://github.com/ikenga-hq/ikenga/discussions', label: 'Discussions' },
			{ href: '/newsletter/', label: 'Newsletter' },
		],
	},
];
---

<footer class="foot" aria-label="Footer">
	{
		COLS.map((c) => (
			<div>
				<h3>{c.title}</h3>
				<ul>
					{c.links.map((l) => (
						<li>
							<a href={l.href}>{l.label}</a>
						</li>
					))}
				</ul>
			</div>
		))
	}
	<div class="legal">
		<p>
			Ikenga is open source under the Apache-2.0 licence. It is not affiliated with or endorsed by Anthropic. Claude
			and Claude Code are trademarks of Anthropic, PBC. Other product names belong to their owners.
		</p>
		<p>
			Privacy: Cloudflare Web Analytics counts page views without cookies. We also count anonymous download clicks and
			install-command copies (event name, page, platform and release only). Our counters never record IP addresses or
			user agents.
		</p>
	</div>
</footer>
