---
// Illustrative permission card, drawn from the released permission inbox.
// Allow and Deny are sample controls; nothing runs from this page.
---

<div class="ask" data-ask-card>
	<div class="ask-who"><span class="seat">@lead</span><span class="eng">claude · session 3</span></div>
	<p class="ask-what">wants to read <code>.env</code></p>
	<div class="ask-act">
		<button class="btn btn-demo" type="button" data-ask="allow">Allow</button>
		<button class="btn btn-quiet" type="button" data-ask="deny">Deny</button>
	</div>
	<p class="ask-state" aria-live="polite">Waiting for you.</p>
</div>
<p class="illus">Illustrative card, drawn from the released permission inbox. Nothing runs from this page.</p>
