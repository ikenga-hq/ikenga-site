---
// Header: the site nav on every page that uses the shared layout (blog, packages, newsletter,
// open source, 404). It is drawn like the home page's top bar: the Ike tile and wordmark on the
// left, the page links, then GitHub and the one ember button, Download.
//
// Mobile (760px and below): the links fold into a native <details> disclosure (no script, works
// with a keyboard and a screen reader) that holds the same links and GitHub.
import BrandIcon from './BrandIcon.astro';

interface Props {
	github?: string;
}
const { github = 'https://github.com/ikenga-hq/ikenga' } = Astro.props;

const NAV = [
	{ href: '/packages/', label: 'Packages' },
	{ href: '/teams/', label: 'Teams' },
	{ href: '/pricing/', label: 'Pricing' },
	{ href: '/security/', label: 'Security' },
	{ href: '/docs/', label: 'Docs' },
	{ href: '/blog/', label: 'Blog' },
];
const DOWNLOAD = 'https://github.com/ikenga-hq/ikenga/releases/latest';
---

<a class="sk-skip" href="#main-content">Skip to main content</a>
<header class="hnav">
	<div class="hnav__bar">
		<a class="hnav__brand" href="/">
			<img class="hnav__mark" src="/ike-app-tile.svg" width="24" height="24" alt="" />
			<span class="hnav__name">Ikenga</span>
		</a>

		<nav class="hnav__links" aria-label="Primary">
			{NAV.map((item) => <a href={item.href}>{item.label}</a>)}
		</nav>

		<span class="hnav__sp"></span>

		<a class="hnav__gh" href={github} rel="noopener" aria-label="GitHub">
			<BrandIcon name="github" size="18px" />
		</a>

		<a class="hnav__cta" href={DOWNLOAD}>Download</a>

		<details class="hnav__disclosure">
			<summary class="hnav__disclosure-btn" aria-label="Open menu">
				<span class="hnav__burger" aria-hidden="true"></span>
			</summary>
			<nav class="hnav__disclosure-panel" aria-label="Primary (mobile)">
				{NAV.map((item) => <a href={item.href}>{item.label}</a>)}
				<hr class="hnav__disclosure-rule" />
				<a href={github} rel="noopener"><BrandIcon name="github" size="15px" /> GitHub</a>
			</nav>
		</details>
	</div>
</header>

<style>
	.hnav {
		position: sticky;
		top: 0;
		z-index: 40;
		background: color-mix(in srgb, var(--bg-base) 88%, transparent);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		border-bottom: 1px solid var(--rule-soft, var(--border-soft));
		font-family: 'Inter', 'Inter Fallback', system-ui, -apple-system, sans-serif;
	}
	.hnav__bar {
		display: flex;
		align-items: center;
		gap: var(--space-5);
		max-width: 64rem;
		margin-inline: auto;
		min-height: 56px;
		padding: 0 var(--space-6);
	}
	.hnav__brand {
		display: inline-flex;
		align-items: center;
		gap: var(--space-3);
		min-height: 44px;
		text-decoration: none;
		color: var(--fg);
	}
	.hnav__mark {
		width: 24px;
		height: 24px;
		flex: none;
		border-radius: 5px;
	}
	.hnav__name {
		font: 600 1.125rem / 1 'Inter', 'Inter Fallback', system-ui, sans-serif;
		letter-spacing: -0.01em;
	}
	.hnav__links {
		display: flex;
		gap: var(--space-4);
	}
	.hnav__links a {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		padding-inline: var(--space-1);
		color: var(--fg-muted);
		text-decoration: none;
		font-size: 0.9375rem;
		transition: color 0.15s ease;
	}
	.hnav__links a:hover {
		color: var(--fg);
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.hnav__sp {
		flex: 1;
	}
	.hnav__gh {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 44px;
		min-height: 44px;
		color: var(--fg-muted);
	}
	.hnav__gh:hover {
		color: var(--fg);
	}
	/* Ember fills one kind of control: Download. */
	.hnav__cta {
		display: inline-flex;
		align-items: center;
		min-height: 36px;
		padding: 0 var(--space-4);
		border-radius: var(--radius-md, 6px);
		background: var(--ember);
		color: var(--bg-base);
		font-weight: 600;
		font-size: 0.9375rem;
		text-decoration: none;
	}
	.hnav__cta:hover {
		background: var(--ember-soft, var(--ember));
	}
	.hnav a:focus-visible,
	.hnav summary:focus-visible {
		outline: 2px solid var(--ember-soft, var(--ember));
		outline-offset: 2px;
		border-radius: var(--radius-sm, 4px);
	}

	/* ── Mobile disclosure (native <details>, no JS) ──────────────────────── */
	.hnav__disclosure {
		display: none;
	}
	.hnav__disclosure-btn {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		border-radius: var(--radius-md, 6px);
		border: 1px solid var(--border);
		cursor: pointer;
		list-style: none;
	}
	.hnav__disclosure-btn::-webkit-details-marker {
		display: none;
	}
	.hnav__burger,
	.hnav__burger::before,
	.hnav__burger::after {
		display: block;
		width: 16px;
		height: 2px;
		background: var(--fg);
		border-radius: 1px;
	}
	.hnav__burger {
		position: relative;
	}
	.hnav__burger::before,
	.hnav__burger::after {
		content: '';
		position: absolute;
		left: 0;
	}
	.hnav__burger::before {
		top: -5px;
	}
	.hnav__burger::after {
		top: 5px;
	}
	.hnav__disclosure[open] .hnav__disclosure-btn {
		border-color: var(--ember);
	}
	/* A closed <details> keeps its layout boxes in Chromium, so hide the panel while closed. */
	.hnav__disclosure:not([open]) .hnav__disclosure-panel {
		display: none;
	}
	.hnav__disclosure-panel {
		position: absolute;
		left: 0;
		right: 0;
		top: 100%;
		display: flex;
		flex-direction: column;
		gap: var(--space-1, 4px);
		padding: var(--space-4) var(--space-6) var(--space-6);
		background: var(--bg-base);
		border-bottom: 1px solid var(--rule-soft, var(--border-soft));
		box-shadow: var(--shadow-3, 0 16px 32px -16px hsla(0, 0%, 0%, 0.4));
	}
	.hnav__disclosure-panel a {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		min-height: 44px;
		padding: 0 4px;
		color: var(--fg);
		text-decoration: none;
		font-size: 1rem;
	}
	.hnav__disclosure-panel a:hover {
		color: var(--ember);
	}
	.hnav__disclosure-rule {
		border: none;
		border-top: 1px solid var(--rule-soft, var(--border-soft));
		margin: var(--space-2, 8px) 0;
	}

	/* ── 760px and below: swap the link row for the disclosure ─────────────── */
	@media (max-width: 760px) {
		.hnav__links,
		.hnav__gh {
			display: none;
		}
		.hnav__bar {
			position: relative;
			gap: var(--space-3);
		}
		.hnav__disclosure {
			display: block;
		}
	}
</style>
