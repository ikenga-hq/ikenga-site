---
/**
 * moment-lab-2.astro — preview harness for the tasks + install moment pair.
 *
 * NOT part of production nav / IA. Exists only so <MomentTasks /> and
 * <MomentInstall /> can be previewed in isolation (dark pole). Mirrors
 * `moment-lab.astro`'s minimal shell (no site Header/Footer chrome). Do not
 * link it from the nav or ship it.
 */
import '../styles/global.css';
import MomentTasks from '../components/moments/MomentTasks.astro';
import MomentInstall from '../components/moments/MomentInstall.astro';
---

<!doctype html>
<html lang="en" data-theme="A" data-mode="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<title>Moment lab 2 · MomentTasks + MomentInstall (dark pole)</title>
		<meta name="description" content="Internal preview harness for the tasks and install moments. Not production nav." />
	</head>
	<body class="sk-page">
		<main id="main-content">
			<MomentTasks tone="dark" autoplay="viewport" />
			<MomentInstall tone="dark" autoplay="viewport" />
		</main>
	</body>
</html>
