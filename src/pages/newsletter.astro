---
// /newsletter — "Building in the Loop." Founder-written, biweekly.
import Layout from '../layouts/Layout.astro';

const title = 'Building in the Loop — Ikenga’s newsletter for Claude Code builders';
const description =
	'Biweekly letters from a founder running a real, in-production Claude Code system. Real workflows, real costs, build-in-public.';
---

<Layout title={title} description={description} canonical="https://ikenga.dev/newsletter">

	<!-- Hero + subscribe -->
	<section class="sk-hero sk-section--flush">
		<div class="sk-wrap">
			<p class="sk-eyebrow">Building in the Loop · Biweekly · Founder-written</p>
			<h1 class="sk-display">Building in the <em>Loop.</em></h1>
			<p class="sk-lede">
				I run a real, in-production Claude Code system every day, doing actual work across a live company. This is the letter where I show how it's
				built: the workflows that hold up, the ones that broke, and what it actually costs to run
				agents like this in production. Build-in-public, no gloss.
			</p>

			<form class="nl-form" id="nl-subscribe-form">
				<label class="sk-sr-only" for="nl-email">Email address</label>
				<input
					id="nl-email"
					class="nl-form__input"
					type="email"
					name="email"
					placeholder="you@email.com"
					required
					autocomplete="email"
				/>
				<!-- honeypot: hidden from humans, catches bots -->
				<input class="nl-form__hp" type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" />
				<button type="submit" class="sk-btn sk-btn--primary nl-form__submit">Subscribe</button>
			</form>
			<p class="nl-form__note">No spam. Unsubscribe anytime.</p>
			<p class="nl-form__msg" id="nl-msg" role="status" aria-live="polite"></p>
		</div>
	</section>

	<!-- What you'll get -->
	<section class="sk-section">
		<div class="sk-wrap">
			<h2 class="sk-h2">What you'll get</h2>
			<ul class="sk-list">
				<li>
					A <strong>biweekly issue</strong> that alternates between a workflow deep-dive (one agent,
					one skill, one automation — how it's actually wired) and a build-in-public note on
					what shipped, what broke, and what it cost.
				</li>
				<li>
					A <strong>monthly screen-recorded tutorial</strong> that walks through one real workflow
					end to end, as a companion to that issue.
				</li>
				<li>
					Links to what's landing in the <strong>Ikenga OSS</strong> repo as it ships —
					agents, skills, and packages, straight from the source.
				</li>
			</ul>
		</div>
	</section>

	<!-- TODO(founder): Discord invite -->

</Layout>

<script>
	// Subscribe — posts to the on-site Resend Pages Function (/api/subscribe),
	// same contract as the homepage form.
	const form = document.getElementById('nl-subscribe-form') as HTMLFormElement | null;
	const msg = document.getElementById('nl-msg');
	form?.addEventListener('submit', async (e) => {
		e.preventDefault();
		const button = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
		const emailEl = form.elements.namedItem('email') as HTMLInputElement | null;
		if (!button || !emailEl || !msg) return;
		const email = emailEl.value.trim();
		const company = (form.elements.namedItem('company') as HTMLInputElement)?.value ?? '';

		button.disabled = true;
		const original = button.textContent;
		button.textContent = 'Subscribing…';
		msg.textContent = '';
		delete msg.dataset.state;
		try {
			const res = await fetch('/api/subscribe', {
				method: 'POST',
				headers: { 'content-type': 'application/json' },
				body: JSON.stringify({ email, company }),
			});
			const data = (await res.json().catch(() => ({}))) as { ok?: boolean; error?: string };
			if (res.ok && data.ok) {
				form.reset();
				msg.textContent = "You're on the list. Welcome.";
				msg.dataset.state = 'ok';
			} else {
				msg.textContent = data.error ?? 'Could not subscribe right now. Please try again.';
				msg.dataset.state = 'error';
			}
		} catch {
			msg.textContent = 'Network error. Please try again.';
			msg.dataset.state = 'error';
		} finally {
			button.disabled = false;
			button.textContent = original;
		}
	});
</script>

<style>
	.sk-sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.nl-form {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		max-width: 30rem;
		flex-wrap: wrap;
		margin: var(--space-6) 0 var(--space-3);
	}
	.nl-form__input {
		flex: 1 1 14rem;
		min-width: 0;
		padding: var(--space-3) var(--space-4);
		background: var(--site-surface);
		border: 1px solid var(--site-border-strong);
		border-radius: var(--radius-md, 6px);
		color: var(--site-fg);
		font-family: var(--site-font-body);
		font-size: 0.9375rem;
	}
	.nl-form__input::placeholder {
		color: var(--site-faint, var(--site-muted));
	}
	.nl-form__input:focus-visible {
		outline: 2px solid var(--site-accent);
		outline-offset: 2px;
	}
	.nl-form__submit {
		flex: none;
	}
	.nl-form__hp {
		position: absolute;
		left: -9999px;
		width: 1px;
		height: 1px;
		opacity: 0;
	}
	.nl-form__msg {
		min-height: 1.25rem;
		font-size: 0.875rem;
		margin: 0;
	}
	.nl-form__msg[data-state='ok'] {
		color: var(--site-accent);
	}
	.nl-form__msg[data-state='error'] {
		color: #e5484d;
	}
	.nl-form__note {
		font-size: 0.8125rem;
		color: var(--site-faint, var(--site-muted));
		font-style: italic;
		margin: 0 0 var(--space-2);
	}
</style>
