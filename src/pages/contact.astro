---
// /contact — Contact page styled like the workspace layout on redesign.
// Supports topic preselection via ?topic=personal|team|enterprise|managed|security|other,
// server-side validation, progressive enhancement without JS, and Resend delivery.
import fs from 'node:fs';
import '../styles/home.css';
import '../components/contact/contact.css';
import IkeSymbol from '../components/home/IkeSymbol.astro';
import IkeMark from '../components/home/IkeMark.astro';
import Icon from '../components/home/Icon.astro';
import ContactFooter from '../components/contact/ContactFooter.astro';
import ContactExplorer from '../components/contact/ContactExplorer.astro';
import ContactForm from '../components/contact/ContactForm.astro';
import { latestRelease } from '../lib/release';

const release = await latestRelease();

const TITLE = 'Contact — Ikenga';
const DESCRIPTION =
	'Get in touch with the Ikenga team for early access, enterprise deployments, security inquiries, or general support.';
const OG_IMAGE = 'https://ikenga.dev/assets/shell/og-card.png';

const ALLOWED_TOPICS = ['personal', 'team', 'enterprise', 'managed', 'security', 'other'];
const queryTopic = Astro.url.searchParams.get('topic')?.toLowerCase() ?? '';
const initialTopic = ALLOWED_TOPICS.includes(queryTopic) ? queryTopic : 'team';

// Add a privacy-notice link only if a /privacy route exists on the branch.
const hasPrivacyRoute =
	fs.existsSync(new URL('./privacy.astro', import.meta.url)) ||
	fs.existsSync(new URL('./privacy.mdx', import.meta.url)) ||
	fs.existsSync(new URL('./privacy/index.astro', import.meta.url));

const platformLine = 'Windows x64 · macOS universal · Linux x86-64, AppImage and .deb';
---

<!doctype html>
<html lang="en" data-theme="A" data-mode="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{TITLE}</title>
		<meta name="description" content={DESCRIPTION} />
		<link rel="canonical" href="https://ikenga.dev/contact" />
		<link rel="icon" type="image/svg+xml" href="/ike-app-tile.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#0c0a08" />
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://ikenga.dev/contact" />
		<meta property="og:title" content={TITLE} />
		<meta property="og:description" content={DESCRIPTION} />
		<meta property="og:image" content={OG_IMAGE} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:image" content={OG_IMAGE} />
		<script is:inline>
			// Before first paint:
			// 1. colour mode: a saved choice, else system setting, else dark;
			// 2. mark that JS is running
			(function () {
				var r = document.documentElement;
				r.setAttribute('data-js', '');
				var m = null;
				try {
					m = localStorage.getItem('ik-mode');
				} catch (e) {}
				if (m !== 'dark' && m !== 'light') {
					m = window.matchMedia && matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
				}
				r.setAttribute('data-mode', m);
			})();
		</script>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
		/>
	</head>
	<body>
		<IkeSymbol />
		<a class="skip" href="#main">Skip to content</a>

		<header class="topbar" aria-label="Ikenga">
			<a class="brand" href="/">
				<IkeMark />
				<span class="wordmark">Ikenga</span>
			</a>
			<button class="mode-btn" type="button" data-mode-toggle aria-label="Switch to light mode">
				<Icon name="moon" />
			</button>
		</header>

		<div class="frame">
			<ContactExplorer version={release.tag} />

			<main id="main">
				<div class="pane">
					<section class="contact-section" aria-labelledby="h-contact">
						<p class="eyebrow">
							<span>Get in touch</span><span aria-hidden="true">·</span><span>Early access</span><span aria-hidden="true"
								>·</span
							><span>hello@royalti.io</span>
						</p>
						<h1 id="h-contact">Get in touch.</h1>
						<p class="lede">
							Whether you want early access to Ikenga for your team, have questions about running your own server,
							need custom builds, or want to discuss a managed instance, we are here.
						</p>

						<ContactForm initialTopic={initialTopic} hasPrivacyRoute={hasPrivacyRoute} />
					</section>

					<ContactFooter />
				</div>
			</main>

			<aside class="companion" aria-label="Companion">
				<div class="co-head">
					<span class="dot" aria-hidden="true"></span>
					<span data-co-title>Direct channels</span>
				</div>
				<div class="co-body">
					<div class="co-ctx">
						<div class="co-panel">
							<h2>Other ways to reach us</h2>
							<p>For immediate inquiries or security disclosures, reach out directly:</p>

							<div class="co-cards">
								<div class="co-card">
									<h3>Direct email</h3>
									<p>Email our founders and core engineering team directly for any request.</p>
									<a class="link" href="mailto:hello@royalti.io">hello@royalti.io</a>
								</div>

								<div class="co-card">
									<h3>Security policy</h3>
									<p>Responsible disclosure guidelines, vulnerability reports and PGP keys.</p>
									<a class="link" href="https://github.com/ikenga-hq/.github/blob/main/SECURITY.md"
										>Read security policy</a
									>
								</div>

								<div class="co-card">
									<h3>Community discussions</h3>
									<p>Ask questions, share workflows, and discuss proposals with the community.</p>
									<a class="link" href="https://github.com/ikenga-hq/ikenga/discussions"
										>GitHub Discussions</a
									>
								</div>
							</div>
						</div>
					</div>
				</div>
			</aside>
		</div>

		<div class="status" role="contentinfo" aria-label="Release status">
			<span class="ok" data-rel-tag>{release.tag}</span><span>Apache-2.0</span><span class="right">{platformLine}</span>
		</div>

		<script>
			// Mode toggle sync
			const root = document.documentElement;
			const $$ = <T extends Element = HTMLElement>(sel: string, scope: ParentNode = document) =>
				Array.from(scope.querySelectorAll<T>(sel) as NodeListOf<T>);

			function setupMode() {
				const sync = () => {
					const light = root.dataset.mode === 'light';
					$$('[data-mode-label]').forEach((el) => (el.textContent = light ? 'Dark mode' : 'Light mode'));
					$$('.mode-btn[data-mode-toggle]').forEach((b) =>
						b.setAttribute('aria-label', light ? 'Switch to dark mode' : 'Switch to light mode'),
					);
				};

				$$('[data-mode-toggle]').forEach((b) =>
					b.addEventListener('click', () => {
						const next = root.dataset.mode === 'light' ? 'dark' : 'light';
						root.dataset.mode = next;
						try {
							localStorage.setItem('ik-mode', next);
						} catch {
							// localStorage unavailable
						}
						sync();
					}),
				);

				sync();
			}

			setupMode();
		</script>
	</body>
</html>
